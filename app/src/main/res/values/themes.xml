<resources>
    <!--
      A black window behind Compose. The app is used in the dark, next to eyes
      that have taken twenty minutes to adapt, so there is never a light flash
      between launch and first frame.
    -->
    <style name="Theme.DeepSky" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <!-- Transparent bars: the app draws edge to edge and insets itself, so the
             viewfinder sits in one continuous dark field rather than between two
             grey strips. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
